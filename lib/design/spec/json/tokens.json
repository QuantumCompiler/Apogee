      {
        "group": "accent & status",
        "tokens": [
          {
            "name": "status.accent",
            "label": "Accent",
            "usedFor": "Live activity, focus rings, the caret, links",
            "contrastAgainst": "surface.window"
          },
          {
            "name": "status.warning",
            "label": "Warning",
            "usedFor": "Context at 80% and above, waiting for you",
            "contrastAgainst": "surface.window"
          },
          {
            "name": "status.error",
            "label": "Error",
            "usedFor": "Failures that need a fix",
            "contrastAgainst": "surface.window"
          }
        ]
      },
      {
        "group": "model types",
        "tokens": [
          {
            "name": "model.local",
            "label": "On this machine",
            "usedFor": "Local model badges and icons",
            "contrastAgainst": "surface.window"
          },
          {
            "name": "model.api",
            "label": "Cloud API · billed",
