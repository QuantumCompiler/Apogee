#compdef apogee
# Zsh completion for apogee. See apogee.bash for why this only forwards.
_apogee() {
    local -a lines
    local directive=:files
    # The protocol matches words literally, and compsys' words are the line's
    # syntax ('models', my\ notes, 'cl): each is sent with one level of its
    # quoting removed by (Q), which never evaluates -- $(...), $VAR and ~
    # stay as typed. The word under the cursor is PREFIX and SUFFIX, inside
    # the quote compstate[quote] says it opened, rewrapped because (Q) leaves
    # an unbalanced 'cl as it is. compadd quotes each candidate for the line.
    # Each quoted, the words with (@): unquoted, an empty word is dropped --
    # a typed '' among the words, or the word under the cursor, empty at a
    # fresh <TAB> -- so `apogee models <TAB>` once arrived as `__complete
    # models`, "still typing models", and no verb below the top level ever
    # completed.
    local q=$compstate[quote]
    lines=(${(f)"$(APOGEE_COMPLETION_PROTOCOL=2 apogee __complete "${(@Q)words[2,CURRENT-1]}" \
        "${(Q)${:-$q$PREFIX$SUFFIX${q#\$}}}" 2>/dev/null)"})
    # The first line says what the rest mean. A binary too old to send one
    # sends bare candidates, which is `:values` -- or nothing, which is files.
    if [[ ${lines[1]} == :* ]]; then
        directive=${lines[1]}
        shift lines
    elif (( ${#lines} )); then
        directive=:values
    fi
    case $directive in
        :values) (( ${#lines} )) && compadd -- $lines ;;
        # Free text, a number, a name: say what it is, and never offer file
        # names for a word that is not a path. No `--`: _message takes the
        # word after -r as the message, whatever it is. `%` doubled, because
        # that message is a prompt-style format.
        :hint\ *) _message -r "${${directive#:hint }//\%/%%}" ;;
        *) _files ;;
    esac
}

# Both installers put this file on fpath, where compinit autoloads it as the
# BODY of _apogee: that body defines the function above and must then run it,
# or the first <TAB> of every shell completes nothing. Sourced, it registers
# the function instead.
if [[ ${funcstack[1]} == _apogee ]]; then
    _apogee "$@"
else
    compdef _apogee apogee
fi
