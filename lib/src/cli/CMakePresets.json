{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "default",
            "inherits": "base",
            "displayName": "Default (host native)",
            "description": "Native build for whatever host you are on. The one-command developer bootstrap."
        },
        {
            "name": "macos-arm64",
            "inherits": "base",
            "displayName": "macOS arm64",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "linux-x64",
            "inherits": "base",
            "displayName": "Linux x86_64"
        },
        {
            "name": "linux-arm64",
            "inherits": "base",
            "displayName": "Linux arm64"
        },
        {
            "name": "windows-mingw",
            "hidden": true,
            "inherits": "base",
            "description": "Windows builds use MinGW-w64 toolchains from MSYS2 (user decision, 2026-09-19): GCC in the UCRT64 environment on x64, clang in CLANGARM64 on arm64. Ninja, because the MSYS2 cmake drives the toolchain on PATH. The executable links -static so it ships alone -- no libstdc++, libgcc or winpthread DLL beside it -- and takes libcurl static for the same reason; cmake/ApogeeDependencies.cmake resolves curl's own static dependencies through pkg-config.",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXE_LINKER_FLAGS": "-static",
                "CURL_USE_STATIC_LIBS": "ON"
            }
        },
        {
            "name": "windows-x64",
            "inherits": "windows-mingw",
            "displayName": "Windows x64 (MinGW-w64, MSYS2 UCRT64)"
        },
        {
            "name": "windows-arm64",
            "inherits": "windows-mingw",
            "displayName": "Windows arm64 (MinGW-w64, MSYS2 CLANGARM64)"
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default" },
        { "name": "macos-arm64", "configurePreset": "macos-arm64" },
        { "name": "linux-x64", "configurePreset": "linux-x64" },
        { "name": "linux-arm64", "configurePreset": "linux-arm64" },
        { "name": "windows-x64", "configurePreset": "windows-x64" },
        { "name": "windows-arm64", "configurePreset": "windows-arm64" }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        { "name": "default", "inherits": "base", "configurePreset": "default" },
        { "name": "macos-arm64", "inherits": "base", "configurePreset": "macos-arm64" },
        { "name": "linux-x64", "inherits": "base", "configurePreset": "linux-x64" },
        { "name": "linux-arm64", "inherits": "base", "configurePreset": "linux-arm64" },
        { "name": "windows-x64", "inherits": "base", "configurePreset": "windows-x64" },
        { "name": "windows-arm64", "inherits": "base", "configurePreset": "windows-arm64" }
    ]
}
