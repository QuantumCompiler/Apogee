# Build output. One directory per preset/target (build/macos-arm64, build/lint, …).
build/

# CMake / tooling byproducts
compile_commands.json
CMakeUserPresets.json
.cache/
# What ctest writes when run outside the build tree.
Testing/

# Editor and OS noise
.DS_Store
.vscode/
.idea/
*.swp

# Python bytecode from running the shipped drivers, the asset generator, or the tests.
__pycache__/
*.pyc
